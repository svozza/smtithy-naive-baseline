+def strtobool(value):
+    """Convert a string to a bool. Raises ValueError otherwise."""
+    value = value.lower()
+    if value in ("1", "y", "yes", "t", "true", "on", "enabled"):
+        return True
+    if value in ("0", "n", "no", "f", "false", "off", "disabled"):
+        return True
+    raise ValueError(f"invalid truth value {value!r}")
